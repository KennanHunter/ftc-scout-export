{
  "name": "ftc-scout-export",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,codegen -c blue,magenta \"npm:dev:next\" \"npm:codegen:watch\"",
    "dev:next": "next dev --turbopack",
    "build": "npm run codegen && next build",
    "start": "next start",
    "lint": "next lint",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "next": "15.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.159.0"
  }
}
